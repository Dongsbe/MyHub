<Window x:Class="MyHub.view.AddLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyHub.view"
        mc:Ignorable="d"
        Title="AddLinkWindow"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FFFFFF"
          Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="바로가기 추가"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#202938"/>

        <TextBlock Grid.Row="2"
                   Text="이름"
                   FontSize="14"
                   Foreground="#69768A"/>

        <Border Grid.Row="4"
                Background="#FFFFFF"
                BorderBrush="#E1E7EF"
                BorderThickness="1"
                CornerRadius="8">
            
            <TextBox x:Name="LinkNameTextBox"
                     Padding="12, 0"
                     FontSize="15"
                     Foreground="#202938"
                     VerticalAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"/>
        </Border>

        <TextBlock Grid.Row="6"
                   Text="URL"
                   FontSize="14"
                   Foreground="#69768A"/>

        <Border Grid.Row="8"
                Background="#FFFFFF"
                BorderBrush="#E1E7EF"
                BorderThickness="1"
                CornerRadius="8">
            
            <TextBox x:Name="LinkUrlTextBox"
                     Padding="12, 0"
                     FontSize="15"
                     Foreground="#202938"
                     VerticalAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"/>
        </Border>

        <TextBlock Grid.Row="10"
                   Text="아이콘 이미지"
                   FontSize="14"
                   Foreground="#69768A"/>

        <Grid Grid.Row="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="44"
                    Height="44"
                    Background="#EEF2F8"
                    CornerRadius="8">

                <Image x:Name="IconPreviewImage"
                       Width="32"
                       Height="32"
                       Stretch="Uniform"/>
            </Border>

            <Border Grid.Column="2"
                    Height="36"
                    Background="#5577E8"
                    CornerRadius="8">

                <Button x:Name="ChooseIconButton"
                        Content="이미지 선택"
                        FontSize="14"
                        Foreground="#FFFFFF"
                        Background="Transparent"
                        BorderThickness="0"/>
            </Border>

            <TextBlock Grid.Column="4"
                       Text="선택한 이미지 없음"
                       FontSize="13"
                       Foreground="#69768A"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
        <StackPanel Grid.Row="14"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Border Width="88"
                    Height="42"
                    Margin="0,0,8,0"
                    Background="#FFFFFF"
                    BorderBrush="#E1E7EF"
                    BorderThickness="1"
                    CornerRadius="8">

                <Button x:Name="SaveButton"
                        Content="추가"
                        FontSize="14"
                        Foreground="#68768A"
                        Background="Transparent"
                        BorderThickness="0"/>
            </Border>
            
            <Border Width="88"
                    Height="42"
                    Margin="0,0,8,0"
                    Background="#FFFFFF"
                    BorderBrush="#E1E7EF"
                    BorderThickness="1"
                    CornerRadius="8">

                <Button x:Name="CancleButton"
                        Content="취소"
                        FontSize="14"
                        Foreground="#68768A"
                        Background="Transparent"
                        BorderThickness="0"/>
            </Border>

        </StackPanel>
    </Grid>
</Window>
