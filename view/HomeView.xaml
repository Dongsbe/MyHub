<UserControl x:Class="MyHub.view.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHub.view"
             mc:Ignorable="d" 
             d:DesignHeight="760"
             d:DesignWidth="1044"
             Background="#F4F6FA">
    <Grid>
        <Viewbox Stretch="Uniform"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Left">
            <Grid Width="1044"
                  Height="760">


                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="HOME"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="12, 10"/>

                <Grid Grid.Row="1"
                      Margin="12, 0, 12, 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Margin=" 0, 0, 12, 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="바로가기"
                                   Margin="0,0,0,7"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <Border Grid.Row="1"
                                CornerRadius="8"
                                Background="White">
                            <Grid Margin="10,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="#EEF2F8">
                                    <Grid>
                                        <Grid.Resources>
                                            <Style x:Key="EditButton"
                                                   TargetType="Button">
                                                <Setter Property="Margin" Value="5"/>
                                                <Setter Property="Width" Value="50"/>
                                                <Setter Property="Height" Value="30"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Cursor" Value="Hand"/>

                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border BorderThickness="1"
                                                                    BorderBrush="#E1E7EF"
                                                                    CornerRadius="6"
                                                                    Background="{TemplateBinding Background}">
                                                                <ContentPresenter VerticalAlignment="Center"
                                                                                  HorizontalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter Property="Background" Value="#F4F6FA"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Resources>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Source="/icon/web-link.png"
                                               Width="30"
                                               Height="30"/>
                                        <TextBlock Grid.Column="1"
                                                   Text=" WEB SITE"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="EditButton"
                                                Grid.Column="3"
                                                Style="{StaticResource EditButton}"
                                                Content="편집"
                                                Click="EditButton_Click"/>
                                    </Grid>

                                </Border>

                                <WrapPanel Grid.Row="1"
                                           Margin="6, 12"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top">

                                    <Button x:Name="AddLinkButton"
                                            Width="72"
                                            Height="68"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Visibility="Collapsed"
                                            Click="AddLinkButton_Click">

                                        <Grid Width="72"
                                              Height="68">
                                        </Grid>
                                    </Button>
                                </WrapPanel> 

                                <Border Grid.Row="2"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="#EEF2F8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Source="/icon/program.png"
                                               Width="30"
                                               Height="30"/>
                                        <TextBlock Grid.Column="1"
                                                   Text=" PROGRAM"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="금일 일정"
                                   Margin="0,0,0,7"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <Border Grid.Row="1"
                                CornerRadius="8"
                                Background="White">


                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>

    </Grid>
</UserControl>
